# ZKNOT Platform API — environment template.
# Copy to .env for local dev, or set these as Railway secrets in production.
# This file holds PLACEHOLDERS ONLY — never commit real secrets.

# Database (Railway provides DATABASE_URL automatically in prod)
DATABASE_URL=postgresql://user:password@localhost:5432/zknot

# Admin / provisioning auth
API_SECRET_KEY=change-me-in-production
ZKNOT_PROVISIONING_TOKEN=
ZKNOT_ZK_CODE_SALT=

# TrustSeal registry signer (P-256 private key, PEM).
# Generate with:  python scripts/gen_registry_key.py
# Paste the full PEM here (or, in prod, into the Railway secret).
# Leave empty to disable TrustSeal registration.
ZKNOT_REGISTRY_PRIVKEY_PEM=
